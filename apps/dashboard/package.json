{
  "name": "@crossagent/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/build-component.mjs @crossagent/dashboard -- vite build",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src e2e",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@crossagent/client": "workspace:*",
    "@crossagent/protocol": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.84.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.8.2",
    "clsx": "^2.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.1.1"
  }
}
