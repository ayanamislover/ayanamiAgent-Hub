{
  "name": "@crossagent/hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-component.mjs @crossagent/hub -- tsup src/main.ts src/index.ts --format esm --dts --clean --external better-sqlite3",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@crossagent/protocol": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.4.0",
    "node-pty": "^1.1.0",
    "picomatch": "^4.0.3",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/picomatch": "^4.0.2",
    "tsup": "^8.5.0"
  }
}
