{
  "name": "@crossagent/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "crossagent": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-component.mjs @crossagent/cli -- tsup src/index.ts src/bin.ts --format esm --dts --clean --external better-sqlite3",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@crossagent/client": "workspace:*",
    "@crossagent/codex-bridge": "workspace:*",
    "@crossagent/hooks": "workspace:*",
    "@crossagent/protocol": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "commander": "^14.0.0",
    "fflate": "^0.8.2",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "tsup": "^8.5.0"
  }
}
