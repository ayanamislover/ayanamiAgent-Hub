{
  "name": "@crossagent/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "development": "./src/terminal.ts",
      "import": "./dist/terminal.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-component.mjs @crossagent/protocol -- tsup src/index.ts src/terminal.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
