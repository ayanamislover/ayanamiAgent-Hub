{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Paths resolve against this file's directory. `baseUrl` is deprecated in TypeScript 6 and
    // stops working in 7, and since 5.0 `paths` no longer needs it as long as the entries are
    // explicitly relative.
    "paths": {
      "@crossagent/protocol/terminal": ["./packages/protocol/src/terminal.ts"],
      "@crossagent/protocol": ["./packages/protocol/src/index.ts"],
      "@crossagent/client": ["./packages/client/src/index.ts"],
      "@crossagent/hub": ["./apps/hub/src/index.ts"],
      "@crossagent/codex-bridge": ["./packages/codex-bridge/src/index.ts"],
      "@crossagent/claude-channel": ["./packages/claude-channel/src/index.ts"],
      "@crossagent/hooks": ["./packages/hooks/src/index.ts"]
    },
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
